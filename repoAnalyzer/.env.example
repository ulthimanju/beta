# Application Configuration
APP_NAME=repoAnalyzer
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (SQLAlchemy - Alembic not required)
DATABASE_URL=sqlite+aiosqlite:///./repo_analyzer.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Message Broker Configuration (RabbitMQ / AMQP)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Observability
OTEL_SERVICE_NAME=repoAnalyzer
PROMETHEUS_METRICS_ENABLED=true
